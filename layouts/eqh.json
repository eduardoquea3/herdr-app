{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces-agents",
              "type": "block",
              "content": {
                "mod": "space-agents"
              }
            }
          ]
        },
        {
          "id": "wsl",
          "type": "block",
          "content": {
            "mod": "wsl"
          },
          "size": {
            "px": 34
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "hidden": true,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tab-bar",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs-lazygit"
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 4,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "lazygit",
                      "type": "column",
                      "children": [
                        {
                          "id": "lazygit-bar",
                          "type": "block",
                          "content": {
                            "mod": "lazygit-panel"
                          },
                          "size": {
                            "px": 30
                          }
                        }
                      ]
                    }
                  ],
                  "active": "lazygit"
                }
              ],
              "size": {
                "px": 520
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 2,
          "gap": 8
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    0,
    0
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
